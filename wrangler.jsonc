// Cloudflare Workers static assets: `npm run build && npx wrangler deploy`.
// Files in dist/ (including /r/*.json and /llms.txt) are served as they are; any other path gets
// index.html so the app's own routes (/components, /blocks, /docs/...) load on a direct visit.
{
  "name": "glazeui",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
